<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:a="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle background outer glowing ring for depth -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#38BDF8"
        android:strokeWidth="1.5"
        android:strokeAlpha="0.3"
        android:pathData="M54,18 C73.88,18 90,34.12 90,54 C90,73.88 73.88,90 54,90 C34.12,90 18,73.88 18,54 C18,34.12 34.12,18 54,18 Z" />

    <!-- Stylized infinity loop path with smooth cubic bezier curves -->
    <path
        android:fillColor="#00000000"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 32,54 C 32,42 43,38 54,54 C 65,70 76,66 76,54 C 76,42 65,38 54,54 C 43,70 32,66 32,54 Z">
        <a:gradient
            android:type="linear"
            android:startX="25"
            android:startY="54"
            android:endX="83"
            android:endY="54">
            <a:item android:offset="0" android:color="#38BDF8" /> <!-- Cyan -->
            <a:item android:offset="0.5" android:color="#6366F1" /> <!-- Indigo -->
            <a:item android:offset="1" android:color="#EC4899" /> <!-- Pink -->
        </a:gradient>
    </path>

    <!-- Play triangle button inside the center of the infinity loop -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 50,45 L 62,54 L 50,63 Z" />

    <!-- A small glowing decorative dot indicating flow/loop motion -->
    <path
        android:fillColor="#38BDF8"
        android:pathData="M 76,54 A 3.5,3.5 0 1,1 69,54 A 3.5,3.5 0 1,1 76,54" />
</vector>
